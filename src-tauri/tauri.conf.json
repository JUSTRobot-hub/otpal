{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Otpal",
  "version": "0.1.0",
  "identifier": "com.otpal.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Otpal", "width": 460, "height": 700, "minWidth": 380, "minHeight": 520 }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "JUSTRobot-hub",
    "copyright": "Copyright (c) 2026 JUSTRobot-hub",
    "homepage": "https://github.com/JUSTRobot-hub",
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
